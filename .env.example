# =============================================================================
# JobHunter AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# =============================================================================

# --- OpenAI (Optional - pipeline works without it via keyword extraction) ---
OPENAI_API_KEY=sk-placeholder

# --- Email Notifications (Optional) ---
# Receive email alerts after each pipeline run.
# For Gmail, use an App Password (not your regular password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=your@email.com

# --- Job API Keys (Optional - adds more job sources) ---
ADZUNA_APP_ID=
ADZUNA_API_KEY=
JOOBLE_API_KEY=
# JSEARCH_API_KEY=       # Reserved for future use (RapidAPI)

# --- API Security (Optional) ---
# If set, clients must pass X-API-Key header to use the FastAPI endpoint.
JOBHUNTER_API_KEY=
