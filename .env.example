# =============================================================================
# JobHunter AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# =============================================================================

# --- OpenAI (Optional - pipeline works without it via keyword extraction) ---
OPENAI_API_KEY=
# Model used for search-query generation
# OPENAI_MODEL=gpt-4o-mini

# --- Groq (Optional - preferred when set; OpenAI-compatible, free tier available) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Email Notifications (Optional) ---
# Receive email alerts after each pipeline run.
# For Gmail, use an App Password (not your regular password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# NOTIFICATION_EMAIL=your@email.com

# --- Job API Keys (Optional - adds more job sources) ---
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=
# JOOBLE_API_KEY=
# JSEARCH_API_KEY=       # Reserved for future use (RapidAPI)

# --- API Security & Limits (Optional) ---
# If set, clients must pass X-API-Key header to use the FastAPI endpoint.
# JOBHUNTER_API_KEY=
# API_RATE_LIMIT=20/minute
# MAX_FILE_SIZE_MB=10

# --- Auto-Apply Agent (Optional - portal login credentials) ---
# Used by the semi-autonomous apply agent (Naukri / Indeed).
# NAUKRI_EMAIL=
# NAUKRI_PASSWORD=
# INDEED_EMAIL=
# INDEED_PASSWORD=
# Apply mode: human (pre-fill, user submits - recommended) | auto | off
# AUTO_APPLY_MODE=human
# MAX_APPLICATIONS_PER_RUN=5
# HEADLESS_BROWSER=false
# Browser login state is persisted at data/browser_state so you log in only once.
# APPLICATION_NOTES=
