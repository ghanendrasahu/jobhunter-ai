# OpenAI API Key (Optional - pipeline works without it via keyword extraction)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-placeholder

# === REAL JOB API KEYS (at least one required for live Indian jobs) ===

# 1. Jooble API (RECOMMENDED - easiest, 100 req/day free)
# Sign up at https://jooble.org/api/about - no credit card required
# Aggregates jobs from Naukri, Indeed, LinkedIn, Monster, TimesJobs, Shine
JOOBLE_API_KEY=

# 2. JSearch API (via RapidAPI - 50 searches/month free)
# Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Aggregates from Indeed, LinkedIn, Glassdoor, Google Jobs
JSEARCH_API_KEY=

# 3. Adzuna API (10 API calls/day free)
# Register at https://developer.adzuna.com/
# Aggregates from Naukri, Monster, Indeed, etc. for India
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Optional API Key for authenticating requests to this service
# If set, clients must pass X-API-Key header
JOBHUNTER_API_KEY=