# =============================================================================
# JobHunter AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# =============================================================================

# --- OpenAI (Optional - pipeline works without it via keyword extraction) ---
OPENAI_API_KEY=
# Model used for search-query generation
# OPENAI_MODEL=gpt-4o-mini

# --- Groq (Optional - preferred when set; OpenAI-compatible, free tier available) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Email Notifications (Optional) ---
# Receive email alerts after each pipeline run.
# For Gmail, use an App Password (not your regular password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# NOTIFICATION_EMAIL=your@email.com

# --- Job API Keys (Optional - adds more job sources) ---
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=
# JOOBLE_API_KEY=
# JSEARCH_API_KEY=       # Reserved for future use (RapidAPI)

# --- API Security & Limits (Optional) ---
# If set, clients must pass X-API-Key header to use the FastAPI endpoint.
# JOBHUNTER_API_KEY=
# API_RATE_LIMIT=20/minute
# MAX_FILE_SIZE_MB=10

# --- Auto-Apply Agent (Optional) ---
# Used by the semi-autonomous apply agent (Naukri / Indeed).
# If left empty, the agent opens the portal login page and waits for you to
# log in manually in the browser window (one-time; session persists afterwards).
# NAUKRI_EMAIL=
# NAUKRI_PASSWORD=
# INDEED_EMAIL=
# INDEED_PASSWORD=
# Apply mode: human (pre-fill, user submits - recommended) | auto | off
# AUTO_APPLY_MODE=human
# MAX_APPLICATIONS_PER_RUN=5
# HEADLESS_BROWSER=false
# Browser engine: chrome (installed Chrome - recommended) | chromium (bundled)
# BROWSER_CHANNEL=chrome
# Reuse your default Chrome account sessions with zero extra login: a minimal
# copy of your real Chrome profile (a few MB) is used, and refreshed automatically
# when your profile changes. Disable to use the dedicated profile instead.
# BROWSER_USE_DEFAULT_PROFILE=true
# Optional explicit Chrome 'User Data' directory (auto-detected when empty):
# Windows: C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# BROWSER_USER_DATA_DIR=
# Seconds to wait for a manual login in the browser window (default 180)
# MANUAL_LOGIN_TIMEOUT=180
# Fresher-only mode: augments the query and skips jobs requiring > N years.
# FRESHER_ONLY=true
# MAX_EXPERIENCE_YEARS=2
# Browser login state is persisted at data/browser_state so you log in only once.
# APPLICATION_NOTES=
